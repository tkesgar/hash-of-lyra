{
  "name": "hash-of-lyra",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "scripts": {
    "lint:eslint": "eslint --flag v10_config_lookup_from_file .",
    "lint:typecheck": "tsc --noEmit",
    "lint:format": "prettier --experimental-cli --check .",
    "lint": "bun lint:eslint && bun lint:typecheck && bun lint:format",
    "format:eslint": "eslint --fix --flag v10_config_lookup_from_file .",
    "format:prettier": "prettier --experimental-cli --write .",
    "format": "bun format:eslint && bun format:prettier",
    "test:vitest": "bun vitest run",
    "test:bun": "bun test test/bun",
    "test": "bun test:vitest && bun test:bun",
    "build": "unbuild",
    "prepack": "unbuild",
    "prepare": "husky"
  },
  "dependencies": {
    "@phc/format": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.1",
    "@eslint/js": "^9.39.2",
    "@phc/argon2": "^1.0.9",
    "@phc/pbkdf2": "^1.1.14",
    "@tsconfig/bun": "~1.0.10",
    "@types/bun": "^1.3.6",
    "@types/phc__format": "^1.0.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript-eslint": "^8.53.1",
    "unbuild": "^3.6.1",
    "vitest": "^4.0.17"
  }
}
